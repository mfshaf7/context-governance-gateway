{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.context-governance-gateway.local/refinement-context-projection-result.schema.json",
  "title": "Refinement Context Projection Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "replayed", "request_id", "correlation_id", "idempotency_key", "request_digest", "binding", "artifact_id", "artifact_digest", "packet_ref", "redaction_receipt_ref", "projection_receipt_ref", "content", "admission_decision", "timeline", "authority"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "ready" },
    "replayed": { "type": "boolean" },
    "request_id": { "$ref": "#/$defs/stableId" },
    "correlation_id": { "$ref": "#/$defs/stableId" },
    "idempotency_key": { "$ref": "#/$defs/stableId" },
    "request_digest": { "$ref": "#/$defs/sha256" },
    "binding": { "$ref": "#/$defs/binding" },
    "artifact_id": { "$ref": "#/$defs/stableId" },
    "artifact_digest": { "$ref": "#/$defs/sha256" },
    "packet_ref": { "type": "string", "pattern": "^/v1/context/packets/[A-Za-z0-9._:-]+$" },
    "redaction_receipt_ref": { "type": "string", "pattern": "^/v1/context/receipts/[A-Za-z0-9._:-]+$" },
    "projection_receipt_ref": { "type": "string", "pattern": "^/v1/context/refinement/projections/[A-Za-z0-9._:-]+$" },
    "content": { "type": "string", "minLength": 1 },
    "admission_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "raw_projection", "redaction_safe"],
      "properties": {
        "profile": { "const": "developer" },
        "raw_projection": { "enum": ["not_requested", "denied"] },
        "redaction_safe": { "const": true }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_at", "projected_at"],
      "properties": {
        "requested_at": { "type": "string", "format": "date-time" },
        "projected_at": { "type": "string", "format": "date-time" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_select_or_invoke_model", "may_approve_suggestion", "may_mutate_delivery"],
      "properties": {
        "may_select_or_invoke_model": { "const": false },
        "may_approve_suggestion": { "const": false },
        "may_mutate_delivery": { "const": false }
      }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "correlation_id", "idempotency_key", "workflow_session_id", "execution_id", "delivery_id", "package_ref", "source_ref", "source_revision", "caller_id", "operator_id", "task", "packet", "target", "requested_at", "context_digest", "budget_tokens"],
      "properties": {
        "request_id": { "$ref": "#/$defs/stableId" },
        "correlation_id": { "$ref": "#/$defs/stableId" },
        "idempotency_key": { "$ref": "#/$defs/stableId" },
        "workflow_session_id": { "$ref": "#/$defs/stableId" },
        "execution_id": { "$ref": "#/$defs/stableId" },
        "delivery_id": { "type": "string", "pattern": "^delivery-[1-9][0-9]*$" },
        "package_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "caller_id": { "$ref": "#/$defs/stableId" },
        "operator_id": { "type": "string", "minLength": 1 },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "contract_ref", "version"],
          "properties": {
            "kind": { "const": "metadata_advice" },
            "contract_ref": { "const": "oos.delivery-refinement.v1" },
            "version": { "const": "1.0" }
          }
        },
        "packet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packet_id", "packet_revision", "source_work_design_receipt_id"],
          "properties": {
            "packet_id": { "$ref": "#/$defs/stableId" },
            "packet_revision": { "type": "string", "minLength": 1 },
            "source_work_design_receipt_id": { "type": "string", "minLength": 1 }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_key", "field_kind", "selected_node_ids"],
          "properties": {
            "field_key": { "$ref": "#/$defs/stableId" },
            "field_kind": { "enum": ["long_text", "number", "select", "short_text"] },
            "selected_node_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } }
          }
        },
        "requested_at": { "type": "string", "format": "date-time" },
        "context_digest": { "$ref": "#/$defs/sha256" },
        "budget_tokens": { "type": "integer", "minimum": 1, "maximum": 8000 }
      }
    }
  }
}
