{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.context-governance-gateway.local/prototype-lifecycle-context-projection-request.schema.json",
  "title": "Prototype Lifecycle Context Projection Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "correlation_id",
    "idempotency_key",
    "workflow_session_id",
    "execution_id",
    "landing_unit_id",
    "operator",
    "lifecycle",
    "requested_at",
    "sources",
    "sources_digest",
    "budget_tokens",
    "subject"
  ],
  "properties": {
    "schema_version": {"const":1},
    "request_id": {"$ref":"#/$defs/stableId"},
    "correlation_id": {"$ref":"#/$defs/stableId"},
    "idempotency_key": {"$ref":"#/$defs/stableId"},
    "workflow_session_id": {"$ref":"#/$defs/stableId"},
    "execution_id": {"$ref":"#/$defs/stableId"},
    "landing_unit_id": {"$ref":"#/$defs/stableId"},
    "operator": {"type":"object","additionalProperties":false,"required":["id"],"properties":{"id":{"$ref":"#/$defs/stableId"}}},
    "lifecycle": {"$ref":"#/$defs/lifecycle"},
    "requested_at": {"type":"string","format":"date-time","maxLength":64},
    "sources": {"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/source"}},
    "sources_digest": {"$ref":"#/$defs/sha256"},
    "budget_tokens": {"type":"integer","minimum":1,"maximum":8000},
    "subject": {"$ref":"#/$defs/prototypeSubject"}
  },
  "$defs": {
    "stableId": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "sha256": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation","state","next_action"],
      "properties": {
        "operation": {"enum":["close","continue","history","inspect","merge","reconstruct","recover","start"]},
        "state": {"$ref":"#/$defs/stableId"},
        "next_action": {"oneOf":[{"$ref":"#/$defs/stableId"},{"type":"null"}]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id","source_class","source_ref","source_revision","captured_at","availability","content","content_digest","unavailable_reason"],
      "properties": {
        "source_id": {"$ref":"#/$defs/stableId"},
        "source_class": {"enum":["art","repository","runtime","validation"]},
        "source_ref": {"type":"string","minLength":1,"maxLength":1024},
        "source_revision": {"type":["string","null"],"minLength":1,"maxLength":256},
        "captured_at": {"type":"string","format":"date-time","maxLength":64},
        "availability": {"enum":["available","unavailable"]},
        "content": {"type":["string","null"],"minLength":1,"maxLength":131072},
        "content_digest": {"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
        "unavailable_reason": {"type":["string","null"],"enum":["expired","not_configured","not_found","unauthorized","unreachable","unsupported",null]}
      },
      "allOf": [
        {
          "if": {"properties":{"availability":{"const":"available"}}},
          "then": {
            "properties": {
              "source_revision": {"type":"string"},
              "content": {"type":"string"},
              "content_digest": {"$ref":"#/$defs/sha256"},
              "unavailable_reason": {"type":"null"}
            }
          },
          "else": {
            "properties": {
              "content": {"type":"null"},
              "content_digest": {"type":"null"},
              "unavailable_reason": {"enum":["expired","not_configured","not_found","unauthorized","unreachable","unsupported"]}
            }
          }
        }
      ]
    },
    "prototypeSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","prototype_id","registry_ref","registry_revision","source_ref","source_revision"],
      "properties": {
        "kind": {"const":"prototype"},
        "prototype_id": {"type":"string","pattern":"^prototype:[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":256},
        "registry_ref": {"type":"string","pattern":"^record://prototypes/[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":512},
        "registry_revision": {"type":"string","pattern":"^[0-9a-f]{40}$"},
        "source_ref": {"type":"string","pattern":"^repo://[a-z0-9][a-z0-9._-]*(?:/[A-Za-z0-9._-]+)*$","maxLength":1024,"not":{"pattern":"/\\.{1,2}(?:/|$)"}},
        "source_revision": {"type":"string","pattern":"^[0-9a-f]{40}$"}
      }
    }
  }
}
