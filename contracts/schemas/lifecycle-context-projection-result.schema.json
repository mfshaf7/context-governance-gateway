{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.context-governance-gateway.local/lifecycle-context-projection-result.schema.json",
  "title": "Lifecycle Context Projection Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "replayed", "request_id", "correlation_id",
    "idempotency_key", "request_digest", "binding", "artifact_id", "artifact_digest",
    "packet_ref", "redaction_receipt_ref", "projection_receipt_ref", "content",
    "admission_decision", "timeline", "authority", "lifecycle_context",
    "source_bindings", "source_summary", "classification", "budget", "projection_safety", "lifecycle_authority"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "ready"},
    "replayed": {"type": "boolean"},
    "request_id": {"$ref": "#/$defs/stableId"},
    "correlation_id": {"$ref": "#/$defs/stableId"},
    "idempotency_key": {"$ref": "#/$defs/stableId"},
    "request_digest": {"$ref": "#/$defs/sha256"},
    "binding": {"$ref": "#/$defs/binding"},
    "artifact_id": {"$ref": "#/$defs/stableId"},
    "artifact_digest": {"$ref": "#/$defs/sha256"},
    "packet_ref": {"type": "string", "pattern": "^/v1/context/packets/[A-Za-z0-9._:-]+$"},
    "redaction_receipt_ref": {"type": "string", "pattern": "^/v1/context/receipts/[A-Za-z0-9._:-]+$"},
    "projection_receipt_ref": {"type": "string", "pattern": "^/v1/context/lifecycle/projections/[A-Za-z0-9._:-]+$"},
    "content": {"type": "string", "minLength": 1},
    "admission_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "raw_projection", "redaction_safe"],
      "properties": {
        "profile": {"const": "developer"},
        "raw_projection": {"enum": ["not_requested", "denied"]},
        "redaction_safe": {"const": true}
      }
    },
    "timeline": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_at", "projected_at"],
      "properties": {
        "requested_at": {"type": "string", "format": "date-time"},
        "projected_at": {"type": "string", "format": "date-time"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["may_select_or_invoke_model", "may_approve_suggestion", "may_mutate_delivery"],
      "properties": {
        "may_select_or_invoke_model": {"const": false},
        "may_approve_suggestion": {"const": false},
        "may_mutate_delivery": {"const": false}
      }
    },
    "lifecycle_context": {"$ref": "#/$defs/lifecycle"},
    "source_bindings": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/sourceBinding"}},
    "source_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "available", "unavailable", "classes"],
      "properties": {
        "total": {"type": "integer", "minimum": 1, "maximum": 16},
        "available": {"type": "integer", "minimum": 0, "maximum": 16},
        "unavailable": {"type": "integer", "minimum": 0, "maximum": 16},
        "classes": {"type": "array", "uniqueItems": true, "items": {"enum": ["art", "repository", "runtime", "validation"]}}
      }
    },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["context_type", "source_classes", "signal_ids"],
      "properties": {
        "context_type": {"const": "lifecycle"},
        "source_classes": {"type": "array", "uniqueItems": true, "items": {"enum": ["art", "repository", "runtime", "validation"]}},
        "signal_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_tokens", "estimated_tokens", "truncated"],
      "properties": {
        "requested_tokens": {"type": "integer", "minimum": 1},
        "estimated_tokens": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    },
    "projection_safety": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_context_exposed", "redaction_applied", "custody_bound"],
      "properties": {
        "raw_context_exposed": {"const": false},
        "redaction_applied": {"type": "boolean"},
        "custody_bound": {"const": true}
      }
    },
    "lifecycle_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["may_choose_action", "may_mutate_art", "may_mutate_source", "may_invoke_model", "may_choose_raw_fallback"],
      "properties": {
        "may_choose_action": {"const": false},
        "may_mutate_art": {"const": false},
        "may_mutate_source": {"const": false},
        "may_invoke_model": {"const": false},
        "may_choose_raw_fallback": {"const": false}
      }
    }
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "state", "next_action"],
      "properties": {
        "operation": {"enum": ["close", "continue", "history", "inspect", "merge", "reconstruct", "recover", "start"]},
        "state": {"$ref": "#/$defs/stableId"},
        "next_action": {"oneOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "request_id", "correlation_id", "idempotency_key", "workflow_session_id",
        "execution_id", "delivery_id", "work_item_ref", "landing_unit_id", "caller_id",
        "operator_id", "lifecycle", "requested_at", "sources_digest", "budget_tokens"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/stableId"},
        "correlation_id": {"$ref": "#/$defs/stableId"},
        "idempotency_key": {"$ref": "#/$defs/stableId"},
        "workflow_session_id": {"$ref": "#/$defs/stableId"},
        "execution_id": {"$ref": "#/$defs/stableId"},
        "delivery_id": {"type": "string", "pattern": "^delivery-[1-9][0-9]*$"},
        "work_item_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "landing_unit_id": {"$ref": "#/$defs/stableId"},
        "caller_id": {"$ref": "#/$defs/stableId"},
        "operator_id": {"$ref": "#/$defs/stableId"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "requested_at": {"type": "string", "format": "date-time"},
        "sources_digest": {"$ref": "#/$defs/sha256"},
        "budget_tokens": {"type": "integer", "minimum": 1, "maximum": 8000}
      }
    },
    "sourceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_class", "source_ref", "source_revision", "captured_at", "availability", "content_digest", "unavailable_reason"],
      "properties": {
        "source_id": {"$ref": "#/$defs/stableId"},
        "source_class": {"enum": ["art", "repository", "runtime", "validation"]},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "source_revision": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "captured_at": {"type": "string", "format": "date-time"},
        "availability": {"enum": ["available", "unavailable"]},
        "content_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "unavailable_reason": {"type": ["string", "null"], "enum": ["expired", "not_configured", "not_found", "unauthorized", "unreachable", "unsupported", null]}
      }
    }
  }
}
